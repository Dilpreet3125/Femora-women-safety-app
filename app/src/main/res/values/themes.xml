<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme updated to MaterialComponents to support modern UI elements like MaterialSwitch -->
    <style name="Theme.Femora" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#D8576B</item>
        <item name="colorPrimaryVariant">#C62839</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#6C5CE7</item>
        <item name="colorSecondaryVariant">#5A4AD1</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>
    
    <style name="ProfileMenuItemStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="ProfileMenuIconStyle">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:tint">#6C5CE7</item>
    </style>

    <style name="ProfileMenuTextStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:textColor">#2D2A4A</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ProfileMenuArrowStyle">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:src">@android:drawable/ic_media_play</item>
        <item name="android:tint">#BDBDBD</item>
    </style>

    <style name="DividerStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">#F0F0F0</item>
    </style>

    <style name="OtpBox">
        <item name="android:layout_width">45dp</item>
        <item name="android:layout_height">55dp</item>
        <item name="android:background">@drawable/input_soft</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textColor">#1A1A2E</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="GuideHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">#7B3FA0</item> <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GuideText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#666666</item> <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

</resources>