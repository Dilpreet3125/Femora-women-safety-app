<?xml version="1.0" encoding="utf-8"?>
<!--
    ══════════════════════════════════════════════════════════════════════
    3-STEP CHANGE PASSWORD DIALOG
    ══════════════════════════════════════════════════════════════════════
    Screen 0 — Change Password   (enter old + new + confirm password)
    Screen 1 — Recover Password  (send verification code to email)
    Screen 2 — Verify Code       (enter the 6-digit OTP)
    ══════════════════════════════════════════════════════════════════════
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/input_soft"
    android:paddingBottom="28dp">

    <!-- ══ DRAG HANDLE ═══════════════════════════════════════════════════ -->
    <View
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/btn_pink"/>

    <!-- ══ BACK BUTTON (hidden on screen 0, visible on 1 & 2) ════════════ -->
    <ImageView
        android:id="@+id/btnDialogBack"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:src="@android:drawable/ic_menu_revert"
        android:padding="4dp"
        android:visibility="gone"
        app:tint="#2D2A4A"
        android:contentDescription="Back"/>

    <!-- ══════════════════════════════════════════════════════════════════ -->
    <!--   VIEW FLIPPER — 3 screens                                        -->
    <!-- ══════════════════════════════════════════════════════════════════ -->
    <ViewFlipper
        android:id="@+id/viewFlipper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inAnimation="@android:anim/slide_in_left"
        android:outAnimation="@android:anim/slide_out_right">

        <!-- ════════════════════════════════════════════════════════════ -->
        <!--   SCREEN 0 — CHANGE PASSWORD                                -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <!-- Lock icon -->
            <LinearLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:background="@drawable/ic_row_icon_bg_pink">
                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@android:drawable/ic_lock_idle_lock"
                    app:tint="#E8476A"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Change Password"
                android:textColor="#1A1A2E"
                android:textSize="21sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Keep your account secure with a strong password"
                android:textColor="#9E9E9E"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="22dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0EAF8"
                android:layout_marginBottom="18dp"/>

            <!-- CURRENT PASSWORD label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CURRENT PASSWORD"
                android:textColor="#9C7BBF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="7dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/input_soft"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_lock_idle_lock"
                    android:layout_marginEnd="10dp"
                    app:tint="#C4A8DC"/>

                <EditText
                    android:id="@+id/etCurrentPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Old Password"
                    android:textColorHint="#CCCCCC"
                    android:inputType="textPassword"
                    android:textColor="#1A1A2E"
                    android:textSize="15sp"
                    android:singleLine="true"/>

                <ImageButton
                    android:id="@+id/btnToggleCurrentPassword"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@null"
                    android:src="@android:drawable/ic_menu_view"
                    android:contentDescription="Toggle visibility"
                    app:tint="#C4A8DC"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvCurrentPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#E74C3C"
                android:textSize="11sp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"/>

            <!-- NEW PASSWORD label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEW PASSWORD"
                android:textColor="#9C7BBF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="7dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/input_soft"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_partial_secure"
                    android:layout_marginEnd="10dp"
                    app:tint="#C4A8DC"/>

                <EditText
                    android:id="@+id/etNewPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="New Password"
                    android:textColorHint="#CCCCCC"
                    android:inputType="textPassword"
                    android:textColor="#1A1A2E"
                    android:textSize="15sp"
                    android:singleLine="true"/>

                <ImageButton
                    android:id="@+id/btnToggleNewPassword"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@null"
                    android:src="@android:drawable/ic_menu_view"
                    android:contentDescription="Toggle visibility"
                    app:tint="#C4A8DC"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvNewPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#E74C3C"
                android:textSize="11sp"
                android:layout_marginBottom="10dp"
                android:visibility="gone"/>

            <!-- Password rules card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F9F5FF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PASSWORD RULES"
                        android:textColor="#9C7BBF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="10dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="7dp">
                        <TextView android:id="@+id/ruleMinLengthIcon" android:layout_width="18dp" android:layout_height="18dp" android:gravity="center" android:text="✗" android:textColor="#E74C3C" android:textSize="11sp" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                        <TextView android:id="@+id/ruleMinLength" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="At least 8 characters" android:textColor="#E74C3C" android:textSize="12sp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="7dp">
                        <TextView android:id="@+id/ruleUppercaseIcon" android:layout_width="18dp" android:layout_height="18dp" android:gravity="center" android:text="✗" android:textColor="#E74C3C" android:textSize="11sp" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                        <TextView android:id="@+id/ruleUppercase" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="At least 1 uppercase letter (A–Z)" android:textColor="#E74C3C" android:textSize="12sp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="7dp">
                        <TextView android:id="@+id/ruleDigitIcon" android:layout_width="18dp" android:layout_height="18dp" android:gravity="center" android:text="✗" android:textColor="#E74C3C" android:textSize="11sp" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                        <TextView android:id="@+id/ruleDigit" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="At least 1 digit (0–9)" android:textColor="#E74C3C" android:textSize="12sp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:id="@+id/ruleSpecialIcon" android:layout_width="18dp" android:layout_height="18dp" android:gravity="center" android:text="✗" android:textColor="#E74C3C" android:textSize="11sp" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                        <TextView android:id="@+id/ruleSpecial" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="At least 1 special character (!@#$%^&amp;*)" android:textColor="#E74C3C" android:textSize="12sp"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CONFIRM PASSWORD label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONFIRM NEW PASSWORD"
                android:textColor="#9C7BBF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="7dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/input_soft"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_secure"
                    android:layout_marginEnd="10dp"
                    app:tint="#C4A8DC"/>

                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Confirm Password"
                    android:textColorHint="#CCCCCC"
                    android:inputType="textPassword"
                    android:textColor="#1A1A2E"
                    android:textSize="15sp"
                    android:singleLine="true"/>

                <ImageButton
                    android:id="@+id/btnToggleConfirmPassword"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@null"
                    android:src="@android:drawable/ic_menu_view"
                    android:contentDescription="Toggle visibility"
                    app:tint="#C4A8DC"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvConfirmPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#E74C3C"
                android:textSize="11sp"
                android:layout_marginBottom="20dp"
                android:visibility="gone"/>

            <!-- CONFIRM CHANGE button -->
            <Button
                android:id="@+id/btnConfirmChange"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/btn_pink"
                android:text="CONFIRM CHANGE"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginBottom="14dp"
                app:backgroundTint="@null"/>

            <!-- Security note -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/ic_row_icon_bg_purple"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_dialog_info"
                    android:layout_marginEnd="10dp"
                    app:tint="#7B3FA0"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="You will be logged out after updating your password."
                    android:textColor="#7B3FA0"
                    android:textSize="11sp"
                    android:lineSpacingMultiplier="1.3"/>
            </LinearLayout>

        </LinearLayout>
        <!-- END SCREEN 0 -->


        <!-- ════════════════════════════════════════════════════════════ -->
        <!--   SCREEN 1 — SEND VERIFICATION CODE (Recover Password)      -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Shield / Lock icon -->
            <LinearLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:background="@drawable/ic_row_icon_bg_pink">
                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@android:drawable/ic_lock_idle_lock"
                    app:tint="#E8476A"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Recover Password"
                android:textColor="#1A1A2E"
                android:textSize="21sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="We'll send a 6-digit verification code to your email to confirm it's really you."
                android:textColor="#9E9E9E"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="24dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0EAF8"
                android:layout_marginBottom="20dp"/>

            <!-- USERNAME (display-only) label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USERNAME"
                android:textColor="#9C7BBF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="7dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/input_soft"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/etSendCodeUsername"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Username"
                    android:textColorHint="#CCCCCC"
                    android:inputType="textPersonName"
                    android:textColor="#1A1A2E"
                    android:textSize="15sp"
                    android:singleLine="true"
                    android:enabled="false"/>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="#C4A8DC"/>
            </LinearLayout>

            <!-- EMAIL ADDRESS label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMAIL ADDRESS"
                android:textColor="#9C7BBF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="7dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/input_soft"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="6dp">

                <EditText
                    android:id="@+id/etSendCodeEmail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Email Address"
                    android:textColorHint="#CCCCCC"
                    android:inputType="textEmailAddress"
                    android:textColor="#1A1A2E"
                    android:textSize="15sp"
                    android:singleLine="true"
                    android:enabled="false"/>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/sym_action_email"
                    app:tint="#C4A8DC"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvSendCodeError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#E74C3C"
                android:textSize="11sp"
                android:layout_marginBottom="20dp"
                android:visibility="gone"/>

            <!-- SEND RECOVERY CODE button -->
            <Button
                android:id="@+id/btnSendRecoveryCode"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/btn_pink"
                android:text="SEND RECOVERY CODE"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:layout_marginBottom="16dp"
                app:backgroundTint="@null"/>

            <!-- Progress bar while sending -->
            <ProgressBar
                android:id="@+id/progressSendCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="4dp"
                android:visibility="gone"/>

            <!-- Try another way -->
            <TextView
                android:id="@+id/tvTryAnotherWay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:text="Try Another Way"
                android:textColor="#E96C74"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>
        <!-- END SCREEN 1 -->


        <!-- ════════════════════════════════════════════════════════════ -->
        <!--   SCREEN 2 — VERIFY CODE                                    -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Shield icon -->
            <LinearLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:background="@drawable/ic_row_icon_bg_pink">
                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@android:drawable/ic_dialog_alert"
                    app:tint="#E8476A"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Verify Code"
                android:textColor="#1A1A2E"
                android:textSize="21sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvVerifySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Enter the 6-digit code sent to your email."
                android:textColor="#9E9E9E"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="24dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0EAF8"
                android:layout_marginBottom="20dp"/>

            <!-- ── 6-DIGIT OTP BOXES ─────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="6dp">

                <EditText
                    android:id="@+id/otpBox1"
                    style="@style/OtpBox"
                    android:layout_marginEnd="8dp"/>

                <EditText
                    android:id="@+id/otpBox2"
                    style="@style/OtpBox"
                    android:layout_marginEnd="8dp"/>

                <EditText
                    android:id="@+id/otpBox3"
                    style="@style/OtpBox"
                    android:layout_marginEnd="8dp"/>

                <EditText
                    android:id="@+id/otpBox4"
                    style="@style/OtpBox"
                    android:layout_marginEnd="8dp"/>

                <EditText
                    android:id="@+id/otpBox5"
                    style="@style/OtpBox"
                    android:layout_marginEnd="8dp"/>

                <EditText
                    android:id="@+id/otpBox6"
                    style="@style/OtpBox"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvOtpError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text=""
                android:textColor="#E74C3C"
                android:textSize="11sp"
                android:layout_marginBottom="4dp"
                android:visibility="gone"/>

            <!-- Resend + countdown -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvResendCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resend Code"
                    android:textColor="#E96C74"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:enabled="false"
                    android:alpha="0.4"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/tvResendCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="(60s)"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"/>

            </LinearLayout>

            <!-- VERIFY CODE button -->
            <Button
                android:id="@+id/btnVerifyCode"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/btn_pink"
                android:text="VERIFY CODE"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginBottom="16dp"
                app:backgroundTint="@null"/>

            <!-- Progress bar while verifying -->
            <ProgressBar
                android:id="@+id/progressVerifyCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="4dp"
                android:visibility="gone"/>

