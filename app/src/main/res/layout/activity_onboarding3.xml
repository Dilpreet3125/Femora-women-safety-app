<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F3F7">

    <!-- CENTER GROUP -->
    <LinearLayout
        android:layout_width="269dp"
        android:layout_height="262dp"
        android:gravity="center"
        android:orientation="vertical"

        app:layout_constraintBottom_toTopOf="@id/dots"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <!-- PURPLE BOX -->
        <FrameLayout
            android:id="@+id/logoImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/purple_box">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:contentDescription="@string/shield_icon"
                android:src="@drawable/ic_shield"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/safety_tips"
            android:textColor="#2D2A4A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- SUBTITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/safety_subtitle"
            android:textColor="#6C63A8"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- DOT INDICATOR -->
    <LinearLayout
        android:id="@+id/dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/btnStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="40dp">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/dot_inactive"
            android:layout_margin="4dp"/>

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/dot_inactive"
            android:layout_margin="4dp"/>

        <View
            android:layout_width="20dp"
            android:layout_height="6dp"
            android:background="@drawable/dot_active"
            android:layout_margin="4dp"/>
    </LinearLayout>

    <!-- GET STARTED BUTTON -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="@string/get_started"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:background="@drawable/btn_pink"
        android:layout_margin="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>