<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_sensitivity_btn.xml
    ──────────────────────
    Background selector for the shake-sensitivity RadioButton pills.
    Checked   → filled purple  (#7B3FA0) with white text  (set textColor in Java)
    Unchecked → white fill with purple stroke
    Place in res/drawable/
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Checked / selected state -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#7B3FA0"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>

    <!-- Pressed state (brief tap feedback) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#5A2E7A"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>

    <!-- Default / unselected state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <stroke android:width="1.5dp" android:color="#D8BFE8"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>

</selector>