<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FE">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_pink"
        android:padding="36dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="29dp"
                android:layout_marginEnd="12dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Safety Tips"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stay informed, stay safe"
            android:textColor="#EEFFFFFF"
            android:textSize="17sp"
            android:layout_marginStart="36dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- Your Safety Matters Banner -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="22dp"
                    android:background="@drawable/btn_pink"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_shield"
                        app:tint="#FFFFFF"
                        android:background="@drawable/sos_circle"
                        android:backgroundTint="#40FFFFFF"
                        android:padding="8dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your Safety Matters"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Follow these essential tips to stay safe and aware in any situation."
                            android:textColor="#EEFFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Do's Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Do's ✓"
                android:textColor="#00C853"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#F1FFF5"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/dashed_border_green">

                    <TextView style="@style/SafetyTipItem" android:text="• Always share your live location with trusted contacts" />
                    <TextView style="@style/SafetyTipItem" android:text="• Keep emergency contacts saved and easily accessible" />
                    <TextView style="@style/SafetyTipItem" android:text="• Trust your instincts - if something feels wrong, it probably is" />
                    <TextView style="@style/SafetyTipItem" android:text="• Stay in well-lit and populated areas at night" />
                    <TextView style="@style/SafetyTipItem" android:text="• Keep your phone charged and have emergency numbers handy" />
                    <TextView style="@style/SafetyTipItem" android:text="• Be aware of your surroundings at all times" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Don'ts Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕ Don'ts ✕"
                android:textColor="#FF3D3D"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#FFF5F5"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/dashed_border_red">

                    <TextView style="@style/SafetyTipItem" android:text="• Don't share personal information with strangers" />
                    <TextView style="@style/SafetyTipItem" android:text="• Avoid walking alone in isolated areas late at night" />
                    <TextView style="@style/SafetyTipItem" android:text="• Don't accept rides from unknown people" />
                    <TextView style="@style/SafetyTipItem" android:text="• Never leave drinks unattended in public places" />
                    <TextView style="@style/SafetyTipItem" android:text="• Don't ignore your gut feeling about unsafe situations" />
                    <TextView style="@style/SafetyTipItem" android:text="• Avoid wearing headphones in both ears while walking alone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Situational Safety -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Situational Safety"
                android:textColor="#2D2A4A"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- At Home -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="12dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            app:tint="#FFFFFF"
                            android:background="@drawable/sos_circle"
                            android:backgroundTint="#4285F4"
                            android:padding="4dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="At Home"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>
                    <TextView style="@style/SituationSubItem" android:text="→ Always lock doors and windows" />
                    <TextView style="@style/SituationSubItem" android:text="→ Install a peephole or camera" />
                    <TextView style="@style/SituationSubItem" android:text="→ Don't let strangers know you're alone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- While Traveling -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="12dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_mylocation"
                            app:tint="#FFFFFF"
                            android:background="@drawable/sos_circle"
                            android:backgroundTint="#9C27B0"
                            android:padding="4dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="While Traveling"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>
                    <TextView style="@style/SituationSubItem" android:text="→ Share your travel plans with someone" />
                    <TextView style="@style/SituationSubItem" android:text="→ Book verified transportation" />
                    <TextView style="@style/SituationSubItem" android:text="→ Keep emergency numbers accessible" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- In Case of Emergency (SOS) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="In Case of Emergency"
                android:textColor="#FF3D3D"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="32dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_shield"
                            app:tint="#FFFFFF"
                            android:background="@drawable/sos_circle"
                            android:backgroundTint="#FF3D3D"
                            android:padding="4dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Immediate Actions"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>
                    <TextView style="@style/SituationSubItem" android:text="→ Press the SOS button to alert your trusted contacts" />
                    <TextView style="@style/SituationSubItem" android:text="→ Move to a public area or a well-lit space" />
                    <TextView style="@style/SituationSubItem" android:text="→ Attract attention by shouting or making noise" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>